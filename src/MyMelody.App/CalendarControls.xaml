<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework">
  <!-- Self-contained palette: this dictionary can be merged before the application's other resources. -->
  <SolidColorBrush x:Key="DateInk" Color="#62434F"/>
  <SolidColorBrush x:Key="DateMuted" Color="#AA8796"/>
  <SolidColorBrush x:Key="DateRose" Color="#BE6E8D"/>
  <SolidColorBrush x:Key="DateLine" Color="#EED6E1"/>
  <SolidColorBrush x:Key="DatePale" Color="#FFF1F6"/>
  <SolidColorBrush x:Key="DateSelected" Color="#F4D2E1"/>

  <Style x:Key="DateCalendarNavigation" TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource DateInk}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="6"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#F4DDE7"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#EBC3D5"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.35"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="DateCalendarDay" TargetType="primitives:CalendarDayButton">
    <Setter Property="Width" Value="34"/><Setter Property="Height" Value="32"/><Setter Property="Margin" Value="1"/>
    <Setter Property="Foreground" Value="{StaticResource DateInk}"/><Setter Property="Background" Value="Transparent"/>
    <Setter Property="FontFamily" Value="맑은 고딕"/><Setter Property="FontSize" Value="12"/>
    <Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="primitives:CalendarDayButton">
          <Grid x:Name="Chrome" Background="Transparent" SnapsToDevicePixels="True">
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="SelectionStates">
                <VisualState x:Name="Unselected"/>
                <VisualState x:Name="Selected"><Storyboard><DoubleAnimation Storyboard.TargetName="Selection" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/></Storyboard></VisualState>
              </VisualStateGroup>
              <VisualStateGroup x:Name="DayStates">
                <VisualState x:Name="RegularDay"/>
                <VisualState x:Name="Today"><Storyboard><DoubleAnimation Storyboard.TargetName="TodayRing" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/><DoubleAnimation Storyboard.TargetName="TodayDot" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/></Storyboard></VisualState>
              </VisualStateGroup>
              <VisualStateGroup x:Name="CalendarButtonFocusStates">
                <VisualState x:Name="CalendarButtonUnfocused"/>
                <VisualState x:Name="CalendarButtonFocused"><Storyboard><DoubleAnimation Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/></Storyboard></VisualState>
              </VisualStateGroup>
              <VisualStateGroup x:Name="BlackoutDayStates">
                <VisualState x:Name="NormalDay"/>
                <VisualState x:Name="BlackoutDay"><Storyboard><DoubleAnimation Storyboard.TargetName="DayContent" Storyboard.TargetProperty="Opacity" To="0.35" Duration="0"/><DoubleAnimation Storyboard.TargetName="BlackoutMark" Storyboard.TargetProperty="Opacity" To="0.7" Duration="0"/></Storyboard></VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Border x:Name="Hover" Background="{StaticResource DatePale}" CornerRadius="10" Opacity="0"/>
            <Border x:Name="TodayRing" BorderBrush="#DCA6BD" BorderThickness="1" CornerRadius="10" Opacity="0"/>
            <Border x:Name="Selection" Background="{StaticResource DateSelected}" BorderBrush="#D793AF" BorderThickness="1" CornerRadius="10" Opacity="0"/>
            <ContentPresenter x:Name="DayContent" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,1"/>
            <Ellipse x:Name="TodayDot" Width="3" Height="3" Fill="{StaticResource DateRose}" VerticalAlignment="Bottom" Margin="0,0,0,3" Opacity="0" IsHitTestVisible="False"/>
            <Path x:Name="BlackoutMark" Data="M0,10 L12,0" Stroke="#BA9BA9" StrokeThickness="1.2" Width="12" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0" IsHitTestVisible="False"/>
            <Border x:Name="FocusRing" BorderBrush="{StaticResource DateRose}" BorderThickness="1.5" CornerRadius="8" Margin="2" Opacity="0" IsHitTestVisible="False"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hover" Property="Opacity" Value="1"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Hover" Property="Background" Value="#EDC4D6"/></Trigger>
            <Trigger Property="IsInactive" Value="True"><Setter Property="Foreground" Value="#BAA2AD"/></Trigger>
            <Trigger Property="IsSelected" Value="True"><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#6A3D50"/></Trigger>
            <Trigger Property="IsBlackedOut" Value="True"><Setter Property="Cursor" Value="Arrow"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.35"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="DateCalendarPeriod" TargetType="primitives:CalendarButton">
    <Setter Property="Width" Value="59"/><Setter Property="Height" Value="56"/><Setter Property="Margin" Value="2"/>
    <Setter Property="Foreground" Value="{StaticResource DateInk}"/><Setter Property="Background" Value="Transparent"/>
    <Setter Property="FontFamily" Value="맑은 고딕"/><Setter Property="FontSize" Value="12"/>
    <Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="primitives:CalendarButton">
          <Grid x:Name="Chrome" Background="Transparent">
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="SelectionStates">
                <VisualState x:Name="Unselected"/>
                <VisualState x:Name="Selected"><Storyboard><DoubleAnimation Storyboard.TargetName="Selection" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/></Storyboard></VisualState>
              </VisualStateGroup>
              <VisualStateGroup x:Name="CalendarButtonFocusStates">
                <VisualState x:Name="CalendarButtonUnfocused"/>
                <VisualState x:Name="CalendarButtonFocused"><Storyboard><DoubleAnimation Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/></Storyboard></VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Border x:Name="Hover" Background="{StaticResource DatePale}" CornerRadius="11" Opacity="0"/>
            <Border x:Name="Selection" Background="{StaticResource DateSelected}" BorderBrush="#D793AF" BorderThickness="1" CornerRadius="11" Opacity="0"/>
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Border x:Name="FocusRing" BorderBrush="{StaticResource DateRose}" BorderThickness="1.5" CornerRadius="9" Margin="2" Opacity="0" IsHitTestVisible="False"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hover" Property="Opacity" Value="1"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Hover" Property="Background" Value="#EDC4D6"/></Trigger>
            <Trigger Property="IsInactive" Value="True"><Setter Property="Foreground" Value="#BAA2AD"/></Trigger>
            <Trigger Property="HasSelectedDays" Value="True"><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.35"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="DateCalendarItem" TargetType="primitives:CalendarItem">
    <Setter Property="Foreground" Value="{StaticResource DateInk}"/>
    <Setter Property="FontFamily" Value="맑은 고딕"/><Setter Property="FontSize" Value="13"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="primitives:CalendarItem">
          <ControlTemplate.Resources>
            <DataTemplate x:Key="{x:Static primitives:CalendarItem.DayTitleTemplateResourceKey}">
              <TextBlock Text="{Binding}" TextWrapping="NoWrap" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource DateMuted}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,7,0,9"/>
            </DataTemplate>
          </ControlTemplate.Resources>
          <Grid x:Name="PART_Root" Width="252">
            <Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Border Grid.Row="0" Background="{StaticResource DatePale}" CornerRadius="12">
              <Grid Margin="3">
                <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions>
                <Button x:Name="PART_PreviousButton" Grid.Column="0" Style="{StaticResource DateCalendarNavigation}" AutomationProperties.Name="이전 달 또는 기간">
                  <Path Data="M7,1 L2,6 L7,11" Width="9" Height="12" Stroke="{StaticResource DateRose}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                </Button>
                <Button x:Name="PART_HeaderButton" Grid.Column="1" Style="{StaticResource DateCalendarNavigation}" FontSize="13" FontWeight="SemiBold" Padding="4" ToolTip="월 또는 연도 선택"/>
                <Button x:Name="PART_NextButton" Grid.Column="2" Style="{StaticResource DateCalendarNavigation}" AutomationProperties.Name="다음 달 또는 기간">
                  <Path Data="M2,1 L7,6 L2,11" Width="9" Height="12" Stroke="{StaticResource DateRose}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                </Button>
              </Grid>
            </Border>
            <!-- CalendarItem populates these exact grids with day titles and date/period buttons. -->
            <Grid x:Name="PART_MonthView" Grid.Row="1" Margin="0,7,0,0" Visibility="Visible">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="36"/><ColumnDefinition Width="36"/><ColumnDefinition Width="36"/><ColumnDefinition Width="36"/><ColumnDefinition Width="36"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
            </Grid>
            <Grid x:Name="PART_YearView" Grid.Row="1" Margin="0,15,0,0" Visibility="Hidden" VerticalAlignment="Center">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <Grid.ColumnDefinitions><ColumnDefinition Width="63"/><ColumnDefinition Width="63"/><ColumnDefinition Width="63"/><ColumnDefinition Width="63"/></Grid.ColumnDefinitions>
            </Grid>
            <Border x:Name="PART_DisabledVisual" Grid.RowSpan="2" CornerRadius="12" Background="#99FFFBFD" Visibility="Collapsed" IsHitTestVisible="False"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="PART_DisabledVisual" Property="Visibility" Value="Visible"/></Trigger>
            <DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource AncestorType={x:Type Calendar}}}" Value="Year">
              <Setter TargetName="PART_MonthView" Property="Visibility" Value="Hidden"/><Setter TargetName="PART_YearView" Property="Visibility" Value="Visible"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource AncestorType={x:Type Calendar}}}" Value="Decade">
              <Setter TargetName="PART_MonthView" Property="Visibility" Value="Hidden"/><Setter TargetName="PART_YearView" Property="Visibility" Value="Visible"/>
            </DataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="PracticePopupCalendar" TargetType="Calendar">
    <Setter Property="Foreground" Value="{StaticResource DateInk}"/><Setter Property="Background" Value="#FFFDFE"/>
    <Setter Property="BorderBrush" Value="{StaticResource DateLine}"/><Setter Property="BorderThickness" Value="1"/>
    <Setter Property="FontFamily" Value="맑은 고딕"/><Setter Property="FontSize" Value="13"/>
    <Setter Property="CalendarItemStyle" Value="{StaticResource DateCalendarItem}"/>
    <Setter Property="CalendarDayButtonStyle" Value="{StaticResource DateCalendarDay}"/>
    <Setter Property="CalendarButtonStyle" Value="{StaticResource DateCalendarPeriod}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Calendar">
          <Grid x:Name="PART_Root" Margin="7,6,7,8">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="18" Padding="13">
              <Border.Effect><DropShadowEffect Color="#92647A" BlurRadius="12" ShadowDepth="2" Opacity="0.14"/></Border.Effect>
              <primitives:CalendarItem x:Name="PART_CalendarItem" Style="{TemplateBinding CalendarItemStyle}" Background="{TemplateBinding Background}" Foreground="{TemplateBinding Foreground}"/>
            </Border>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="PracticeDateTextBox" TargetType="primitives:DatePickerTextBox">
    <Setter Property="Foreground" Value="{StaticResource DateInk}"/><Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/>
    <Setter Property="CaretBrush" Value="{StaticResource DateRose}"/><Setter Property="SelectionBrush" Value="{StaticResource DateSelected}"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Cursor" Value="IBeam"/>
    <Setter Property="AutomationProperties.Name" Value="{Binding Path=(AutomationProperties.Name), RelativeSource={RelativeSource AncestorType={x:Type DatePicker}}}"/>
    <Setter Property="AutomationProperties.LabeledBy" Value="{Binding Path=(AutomationProperties.LabeledBy), RelativeSource={RelativeSource AncestorType={x:Type DatePicker}}}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="primitives:DatePickerTextBox">
          <Grid Background="{TemplateBinding Background}">
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="WatermarkStates">
                <VisualState x:Name="Unwatermarked"/>
                <VisualState x:Name="Watermarked"><Storyboard><DoubleAnimation Storyboard.TargetName="PART_Watermark" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/></Storyboard></VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <ScrollViewer x:Name="PART_ContentHost" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"/>
            <ContentControl x:Name="PART_Watermark" Opacity="0" Foreground="{StaticResource DateMuted}" VerticalAlignment="Center" Focusable="False" IsHitTestVisible="False">
              <ContentControl.ContentTemplate><DataTemplate><TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/></DataTemplate></ContentControl.ContentTemplate>
            </ContentControl>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="PracticeDatePicker" TargetType="DatePicker">
    <Setter Property="Width" Value="150"/><Setter Property="Height" Value="40"/>
    <Setter Property="Foreground" Value="{StaticResource DateInk}"/><Setter Property="Background" Value="#FFFDFE"/>
    <Setter Property="BorderBrush" Value="{StaticResource DateLine}"/><Setter Property="BorderThickness" Value="1"/>
    <Setter Property="FontFamily" Value="맑은 고딕"/><Setter Property="FontSize" Value="13"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="CalendarStyle" Value="{StaticResource PracticePopupCalendar}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="DatePicker">
          <Grid x:Name="PART_Root" SnapsToDevicePixels="True">
            <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12">
              <Grid Margin="10,3,3,3">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions>
                <!-- DatePicker owns text synchronization and inserts its Calendar into the empty popup. -->
                <primitives:DatePickerTextBox x:Name="PART_TextBox" Grid.Column="0" Margin="0,0,4,0" Style="{StaticResource PracticeDateTextBox}" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" FontFamily="{TemplateBinding FontFamily}" Focusable="{TemplateBinding Focusable}"/>
                <Button x:Name="PART_Button" Grid.Column="1" Style="{StaticResource DateCalendarNavigation}" Background="{StaticResource DatePale}" Padding="6" Focusable="False" AutomationProperties.Name="달력 열기" ToolTip="달력에서 날짜 선택">
                  <Path Data="M3,3.5 H13 A1.5,1.5 0 0 1 14.5,5 V13 A1.5,1.5 0 0 1 13,14.5 H3 A1.5,1.5 0 0 1 1.5,13 V5 A1.5,1.5 0 0 1 3,3.5 M5,1.5 V5 M11,1.5 V5 M1.5,7 H14.5 M5,10 H5.1 M8,10 H8.1 M11,10 H11.1" Width="16" Height="16" Stroke="{StaticResource DateRose}" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform"/>
                </Button>
              </Grid>
            </Border>
            <Border x:Name="FocusRing" BorderBrush="#CD8BA7" BorderThickness="1.5" CornerRadius="12" Opacity="0" IsHitTestVisible="False"/>
            <Popup x:Name="PART_Popup" PlacementTarget="{Binding ElementName=PART_TextBox}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#DCA6BE"/></Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="FocusRing" Property="Opacity" Value="1"/></Trigger>
            <Trigger Property="IsDropDownOpen" Value="True"><Setter TargetName="FocusRing" Property="Opacity" Value="1"/></Trigger>
            <Trigger Property="Validation.HasError" Value="True"><Setter TargetName="FocusRing" Property="BorderBrush" Value="#B85472"/><Setter TargetName="FocusRing" Property="Opacity" Value="1"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="PART_Root" Property="Opacity" Value="0.45"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>

<Window x:Class="MyMelody.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:MyMelody.App"
 Title="마이멜로디 연습 친구" Width="1060" Height="790" MinWidth="900" MinHeight="690" WindowStartupLocation="CenterScreen"
 Style="{StaticResource {x:Type Window}}" FontFamily="Malgun Gothic" UseLayoutRounding="True" SnapsToDevicePixels="True">
 <Grid Background="#FFFBFC">
  <Grid.ColumnDefinitions><ColumnDefinition Width="196"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#FFF0F4" BorderBrush="#EFDFE5" BorderThickness="0,0,1,0">
   <DockPanel Margin="20,30,20,22">
    <StackPanel DockPanel.Dock="Top" Margin="8,0,0,28">
     <TextBlock Text="MY MELODY" FontSize="12" FontWeight="Bold" Foreground="#BA6D87"/>
     <TextBlock Text="연습 친구" FontSize="25" FontWeight="Bold" Margin="0,6,0,0"/>
     <TextBlock Text="작은 연습, 다정한 성장" Style="{StaticResource Caption}" Margin="0,8,0,0"/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Margin="8,16,8,0">
     <Border Background="#FBE2EB" CornerRadius="12" Padding="12"><StackPanel>
      <TextBlock Text="오늘도 함께해요 ♡" FontWeight="SemiBold" FontSize="12"/>
      <TextBlock x:Name="SidebarStatus" Text="건반을 연결해 주세요" Style="{StaticResource Caption}" Margin="0,6,0,0"/>
     </StackPanel></Border>
     <TextBlock x:Name="VersionLabel" Text="나만의 연습 공간" Style="{StaticResource Caption}" Margin="0,14,0,0" FontSize="10"/>
    </StackPanel>
    <StackPanel>
     <Button x:Name="HomeNav" Style="{StaticResource NavButton}" Content="⌂   함께 연습하기" Tag="Home" Click="NavigateClick"/>
     <Button x:Name="CollectionNav" Style="{StaticResource NavButton}" Content="♡   마이 컬렉션" Tag="Collection" Click="NavigateClick"/>
     <Button x:Name="RecordsNav" Style="{StaticResource NavButton}" Content="▦   연습 기록" Tag="Records" Click="NavigateClick"/>
     <Button x:Name="SettingsNav" Style="{StaticResource NavButton}" Content="⚙   설정" Tag="Settings" Click="NavigateClick"/>
    </StackPanel>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1" Margin="30,28,30,20">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Margin="0,0,0,22"><StackPanel><TextBlock x:Name="PageEyebrow" Text="OUR LITTLE PRACTICE ROOM" Style="{StaticResource Caption}" FontSize="10"/><TextBlock x:Name="PageTitle" Text="오늘도, 조금씩 함께 자라요" FontWeight="Bold" FontSize="26" Margin="0,7,0,0"/></StackPanel>
    <Border HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="15" Background="#F5EBEF" Padding="12,6"><TextBlock x:Name="ConnectionBadge" Text="연결 대기" FontSize="11" Foreground="#967686"/></Border>
   </Grid>
   <Border x:Name="UpdateBanner" Grid.Row="1" Visibility="Collapsed" Background="#F7E8F0" CornerRadius="12" Padding="14,10" Margin="0,0,0,15"><DockPanel>
    <Button DockPanel.Dock="Right" Content="자세히 보기" Click="ShowUpdatesClick" Padding="10,5"/>
    <TextBlock x:Name="UpdateBannerText" Text="새 버전이 도착했어요." VerticalAlignment="Center"/>
   </DockPanel></Border>
   <ScrollViewer x:Name="PageScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,7,0">
    <Grid>
     <StackPanel x:Name="HomePage">
      <Border Style="{StaticResource Card}" Background="#FFF3F6" Padding="24">
       <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid Height="254">
         <Ellipse Width="205" Height="205" Fill="#FCE3EC" VerticalAlignment="Center"/>
         <TextBlock Text="✧" FontSize="25" Foreground="#D7A2B7" Margin="8,30,0,0" HorizontalAlignment="Left"/>
         <TextBlock Text="+" FontSize="20" Foreground="#D7A2B7" Margin="0,0,12,35" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
         <local:SpriteView x:Name="HeroSprite" Width="200" Height="210"/>
         <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" CornerRadius="12" Background="White" Padding="12,5"><TextBlock x:Name="StageLabel" Text="첫 만남을 기다리는 중" FontSize="11" Foreground="#AE6480"/></Border>
        </Grid>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="24,0,0,0">
         <TextBlock Text="MY PRACTICE COMPANION" FontSize="10" Foreground="#B87B93" FontWeight="SemiBold"/>
         <TextBlock x:Name="CompanionName" Text="어떤 친구를 만나게 될까요?" FontSize="23" FontWeight="Bold" Margin="0,9,0,8"/>
         <TextBlock x:Name="CompanionMessage" Text="첫 마이멜로디를 뽑고&#10;우리의 연습 이야기를 시작해요." Foreground="#947B85" LineHeight="23"/>
         <ProgressBar x:Name="GrowthProgress" Maximum="1" Margin="0,20,0,8"/>
         <TextBlock x:Name="GrowthDetail" Style="{StaticResource Caption}" Text="한 단계마다 연습 12시간"/>
         <Button x:Name="DrawButton" Content="♡  첫 친구 만나기" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,18,0,0" Click="DrawClick"/>
        </StackPanel>
       </Grid>
      </Border>
      <UniformGrid Columns="3" Margin="0,18,0,18">
       <Border Style="{StaticResource Card}" Margin="0,0,10,0" Padding="17"><StackPanel><TextBlock Text="오늘의 연습" Style="{StaticResource Caption}"/><TextBlock x:Name="TodayTotal" Text="0분" FontSize="26" FontWeight="Bold" Margin="0,9,0,0"/></StackPanel></Border>
       <Border Style="{StaticResource Card}" Margin="0,0,10,0" Padding="17"><StackPanel><TextBlock Text="이번 주의 연습" Style="{StaticResource Caption}"/><TextBlock x:Name="WeekTotal" Text="0분" FontSize="26" FontWeight="Bold" Margin="0,9,0,0"/></StackPanel></Border>
       <Border Style="{StaticResource Card}" Padding="17"><StackPanel><TextBlock Text="함께한 친구" Style="{StaticResource Caption}"/><TextBlock x:Name="CollectedTotal" Text="0 / 9" FontSize="26" FontWeight="Bold" Margin="0,9,0,0"/></StackPanel></Border>
      </UniformGrid>
      <Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <StackPanel><TextBlock x:Name="PracticeStatus" Text="연습을 기다리고 있어요" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="PracticeHint" Text="건반을 누르면 연습 시간이 자동으로 쌓여요." Style="{StaticResource Caption}" Margin="0,8,10,0"/></StackPanel>
       <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="PauseButton" Content="일시정지" Click="PauseClick" Margin="0,0,8,0"/><Button x:Name="ManualButton" Content="수동 연습 시작" Click="ManualClick"/></StackPanel>
      </Grid></Border>
      <TextBlock Text="잘 치는 날도, 천천히 반복하는 날도. 모든 연습이 같은 속도로 성장이 돼요." Style="{StaticResource Caption}" Margin="4,16,4,6"/>
     </StackPanel>
     <StackPanel x:Name="CollectionPage" Visibility="Collapsed">
      <TextBlock Text="한 친구와 36시간을 함께하면, 다음 친구를 만날 수 있어요." Style="{StaticResource Caption}" Margin="0,0,0,18"/>
      <UniformGrid x:Name="CollectionGrid" Columns="3"/>
      <TextBlock Text="완성한 친구를 바탕화면에 꺼내 두어도 지금 키우는 친구는 계속 성장해요." Style="{StaticResource Caption}" Margin="4,10,0,0"/>
     </StackPanel>
     <StackPanel x:Name="RecordsPage" Visibility="Collapsed">
      <Border Style="{StaticResource Card}" Margin="0,0,0,16"><DockPanel><TextBlock Text="지금까지 함께한 시간" Style="{StaticResource Caption}" VerticalAlignment="Center"/><TextBlock x:Name="AllTimeTotal" DockPanel.Dock="Right" Text="0분" FontSize="24" FontWeight="Bold" HorizontalAlignment="Right"/></DockPanel></Border>
      <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel>
       <DockPanel Margin="0,0,0,15"><Button DockPanel.Dock="Left" Content="‹" Click="PreviousMonthClick" Padding="12,4"/><Button DockPanel.Dock="Right" Content="›" Click="NextMonthClick" Padding="12,4"/><TextBlock x:Name="MonthTitle" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></DockPanel>
       <UniformGrid Columns="7" Margin="0,0,0,8"><TextBlock Text="일" HorizontalAlignment="Center"/><TextBlock Text="월" HorizontalAlignment="Center"/><TextBlock Text="화" HorizontalAlignment="Center"/><TextBlock Text="수" HorizontalAlignment="Center"/><TextBlock Text="목" HorizontalAlignment="Center"/><TextBlock Text="금" HorizontalAlignment="Center"/><TextBlock Text="토" HorizontalAlignment="Center"/></UniformGrid>
       <UniformGrid x:Name="CalendarGrid" Columns="7"/>
      </StackPanel></Border>
      <TextBlock Text="연습 세션" Style="{StaticResource SectionTitle}"/>
      <TextBlock Text="연습 구간 사이의 휴식이 30분 미만이면 한 세션으로 묶어요. 인정 시간만 합산해요." Style="{StaticResource Caption}" Margin="0,0,0,12"/>
      <TextBlock x:Name="SessionEmpty" Text="첫 연습을 시작하면 여기에 기록이 남아요." Style="{StaticResource Caption}" Margin="0,0,0,10"/>
      <StackPanel x:Name="SessionsList"/>
     </StackPanel>
     <StackPanel x:Name="SettingsPage" Visibility="Collapsed">
      <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel>
       <TextBlock Text="♪  연습 입력" Style="{StaticResource SectionTitle}"/>
       <DockPanel><Button Content="새로 고침" DockPanel.Dock="Right" Click="RefreshMidiClick" Margin="10,0,0,0"/><ComboBox x:Name="MidiDeviceBox" DisplayMemberPath="Name" SelectionChanged="MidiSelectionChanged"/></DockPanel>
       <TextBlock x:Name="MidiMessage" Text="Cakewalk와 같은 건반을 선택해 주세요." Style="{StaticResource Caption}" Margin="0,12,0,0"/>
      </StackPanel></Border>
      <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel>
       <TextBlock Text="♡  바탕화면 친구" Style="{StaticResource SectionTitle}"/>
       <DockPanel><TextBlock x:Name="SizeLabel" Text="캐릭터 크기 · 96" DockPanel.Dock="Top" Style="{StaticResource Caption}" Margin="0,0,0,10"/><Slider x:Name="SizeSlider" Minimum="48" Maximum="384" TickFrequency="8" IsSnapToTickEnabled="True" Value="96" ValueChanged="CharacterSizeChanged"/></DockPanel>
       <CheckBox x:Name="TopmostCheck" Content="다른 창 위에 항상 표시" Click="SettingsChanged"/>
       <CheckBox x:Name="VisibleCheck" Content="바탕화면에 캐릭터 표시" Click="SettingsChanged"/>
       <CheckBox x:Name="SoundCheck" Content="성장할 때 작은 알림 소리" Click="SettingsChanged"/>
       <CheckBox x:Name="StartupCheck" Content="Windows 시작 시 자동 실행" Click="SettingsChanged"/>
       <Button Content="캐릭터 위치 초기화" HorizontalAlignment="Left" Click="ResetPositionClick" Margin="0,8,0,0"/>
      </StackPanel></Border>
      <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel>
       <TextBlock Text="▦  저장과 백업" Style="{StaticResource SectionTitle}"/>
       <TextBlock Text="기록은 이 PC에 자동 저장돼요. 매일 백업하며 최근 7개를 보관해요." Style="{StaticResource Caption}"/>
       <WrapPanel Margin="0,14,0,0"><Button Content="백업 내보내기" Click="BackupClick" Margin="0,0,8,8"/><Button Content="백업 복원" Click="RestoreClick" Margin="0,0,8,8"/><Button Content="저장 폴더 열기" Click="OpenDataClick" Margin="0,0,0,8"/></WrapPanel>
      </StackPanel></Border>
      <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel>
       <TextBlock Text="✧  앱 업데이트" Style="{StaticResource SectionTitle}"/>
       <TextBlock x:Name="UpdateVersion" Text="현재 버전 확인 중"/>
       <CheckBox x:Name="AutoUpdateCheck" Content="새 버전 자동 확인 (6시간마다)" Click="SettingsChanged"/>
       <TextBlock x:Name="UpdateStatus" Text="업데이트 확인 전" Style="{StaticResource Caption}" Margin="0,4,0,6"/>
       <TextBlock x:Name="LastCheckLabel" Style="{StaticResource Caption}" Margin="0,0,0,10"/>
       <ProgressBar x:Name="UpdateProgress" Maximum="100" Visibility="Collapsed" Margin="0,0,0,12"/>
       <WrapPanel><Button x:Name="CheckUpdateButton" Content="지금 확인" Click="CheckUpdateClick" Margin="0,0,8,8"/><Button x:Name="ApplyUpdateButton" Content="업데이트하고 다시 시작" Style="{StaticResource PrimaryButton}" Click="ApplyUpdateClick" Visibility="Collapsed" Margin="0,0,0,8"/></WrapPanel>
       <TextBlock x:Name="ReleaseNotes" Style="{StaticResource Caption}" Margin="0,8,0,0"/>
       <TextBlock Text="버튼을 누르기 전에는 다운로드하거나 설치하지 않아요." Style="{StaticResource Caption}" Margin="0,10,0,0"/>
      </StackPanel></Border>
     </StackPanel>
    </Grid>
   </ScrollViewer>
   <Border x:Name="ToastBorder" Grid.Row="3" Background="#F4E3EA" CornerRadius="10" Padding="12,8" Margin="0,10,0,0" Visibility="Collapsed"><TextBlock x:Name="ToastText" FontSize="12"/></Border>
  </Grid>
 </Grid>
</Window>
